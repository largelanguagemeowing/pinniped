{
  "name": "pinniped",
  "version": "4.12.6",
  "description": "Yet another matrix client",
  "desktopName": "pinniped.desktop",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=16.0.0"
  },
  "scripts": {
    "build:element-call": "node scripts/fork/element-call/build.mjs",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "lint": "npm run check:eslint && npm run check:prettier",
    "check:eslint": "eslint src",
    "check:prettier": "prettier --check .",
    "fix:prettier": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "bump": "node scripts/update-version.js",
    "electron:start": "electron electron/main.cjs",
    "electron:dist": "npm run build && electron-builder --config electron/electron-builder.yml --linux",
    "electron:dist:win": "npm run build && electron-builder --config electron/electron-builder.yml --win",
    "electron:dist:mac": "npm run build && electron-builder --config electron/electron-builder.yml --mac"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": "eslint",
    "*": "prettier --ignore-unknown --write"
  },
  "keywords": [],
  "author": "Ajay Bura",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.2.1",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "3.0.0",
    "@fontsource/inter": "4.5.14",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-virtual": "3.14.23",
    "@vanilla-extract/css": "1.21.3",
    "@vanilla-extract/recipes": "0.5.7",
    "await-to-js": "3.0.0",
    "badwords-list": "2.0.1-4",
    "blurhash": "2.0.5",
    "browser-encrypt-attachment": "0.3.0",
    "chroma-js": "3.2.0",
    "classnames": "2.5.1",
    "dayjs": "1.11.23",
    "domhandler": "6.0.1",
    "emojibase": "18.0.0",
    "emojibase-data": "18.0.0",
    "events": "3.3.0",
    "file-saver": "2.0.5",
    "focus-trap-react": "12.0.3",
    "folds": "2.7.3",
    "html-dom-parser": "8.0.2",
    "html-react-parser": "6.1.9",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "i18next-http-backend": "4.0.6",
    "immer": "11.2.9",
    "is-hotkey": "0.2.1",
    "jotai": "3.0.1",
    "jotai-family": "1.1.0",
    "jszip": "3.10.2",
    "linkify-react": "4.4.0",
    "linkifyjs": "4.4.0",
    "lucide-react": "1.63.0",
    "matrix-js-sdk": "45.0.0",
    "matrix-widget-api": "1.20.0",
    "millify": "6.1.0",
    "pdfjs-dist": "6.4.299",
    "prismjs": "1.30.0",
    "react": "19.3.1",
    "react-aria": "3.53.1",
    "react-blurhash": "0.3.0",
    "react-colorful": "5.8.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "6.1.6",
    "react-google-recaptcha": "3.1.0",
    "react-i18next": "17.1.9",
    "react-range": "1.10.0",
    "react-router-dom": "7.18.5",
    "sanitize-html": "2.18.1",
    "slate": "0.147.4",
    "slate-dom": "0.147.3",
    "slate-history": "0.144.0",
    "slate-react": "0.147.5",
    "ua-parser-js": "2.0.10"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
